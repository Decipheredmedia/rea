# Settings for local-ai-stack. ./stack install copies this file to .env and
# fills in the three secrets. Edit .env, then run ./stack up to apply.

# Which optional parts run: chat (Open WebUI), automation (n8n), image (ComfyUI).
# Change with ./stack enable / ./stack disable rather than by hand.
COMPOSE_PROFILES=chat

# Models. The chat model is the base for the "coder" and "debugger" assistants.
# On 2 GB of RAM keep a 0.5B-1.5B model; qwen2.5-coder:0.5b is faster but weaker.
CHAT_MODEL=qwen2.5-coder:1.5b
EMBED_MODEL=all-minilm
DEFAULT_MODEL=coder:latest
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=10m

# Who can reach the web pages. 127.0.0.1 = only through an SSH tunnel (safest).
# 0.0.0.0 = anyone on the internet; Docker ignores the ufw firewall for these
# ports, so only do this behind HTTPS and with strong passwords.
BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000
N8N_PORT=5678
COMFYUI_PORT=8188
OLLAMA_PORT=11434
QDRANT_PORT=6333

# Open WebUI reads these only on its first start; afterwards change them in
# its Admin Panel > Settings.
WEBUI_NAME=Local AI
ENABLE_WEB_SEARCH=false

# n8n: set to false only if you serve n8n over plain http on a public address.
N8N_SECURE_COOKIE=true
TZ=UTC

# Pinned images. Open WebUI's "main" tag is its latest release.
OLLAMA_IMAGE=ollama/ollama:0.40.16
QDRANT_IMAGE=qdrant/qdrant:v1.20.1
N8N_IMAGE=n8nio/n8n:2.47.7
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
COMFYUI_REF=master

# Secrets: generated by ./stack install. Keep this file private (mode 600).
WEBUI_SECRET_KEY=
QDRANT_API_KEY=
N8N_ENCRYPTION_KEY=
